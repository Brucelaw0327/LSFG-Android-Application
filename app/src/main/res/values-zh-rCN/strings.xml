    <string name="param_cpu_saturation">饱和度</string>
    <string name="param_cpu_saturation_desc">0 为去色；50 为中性；拉满则色彩浓艳。</string>
    <string name="param_cpu_vibrance">自然度</string>
    <string name="param_cpu_vibrance_desc">提升低饱和像素而不放大已经鲜艳的部分。适合改善发灰的 HUD 和肤色。</string>
    <string name="param_cpu_vignette">暗角</string>
