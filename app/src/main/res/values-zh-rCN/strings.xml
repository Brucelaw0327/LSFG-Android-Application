    <string name="overlay_mode_drawer_warning_cancel">取消</string>
    <string name="section_hud">HUD</string>
    <string name="section_trusted_overlay">触摸穿透</string>
    <string name="param_trusted_overlay">受信任悬浮层（无障碍）</string>
    <string name="param_trusted_overlay_desc">将悬浮层托管为受信任的无障碍表面，使点击能穿透到下层应用——某些严格的设备（如 Orange Pi 5 Ultra）会拦截这类点击。代价：会话运行期间悬浮层会覆盖状态栏和导航栏——你无法下拉通知栏或点按主页/返回键。如果你的设备本身能穿透点击请保持关闭；只有无法穿透时才开启。需要先启用 LSFG 无障碍服务。</string>
    <string name="section_capture_mode">捕获模式</string>
    <string name="capture_mode_mediaprojection">MediaProjection</string>
    <string name="capture_mode_shizuku">Shizuku 捕获</string>
    <string name="capture_mode_root">Root 捕获</string>
    <string name="capture_mode_desc">MediaProjection 通过 Android 屏幕共享捕获。Shizuku 和 Root 捕获走特权且按目标 UID 过滤的捕获路径，适用于 MediaProjection 会把悬浮层也捕获进去的设备。</string>
    <string name="pause_on_touch_title">触摸时暂停插帧</string>
    <string name="fps_guard_title">原始帧率超阈值自动关闭</string>
    <string name="fps_guard_desc">开启帧生成后监测目标应用的原始帧率几秒，若持续高于设定阈值则自动结束会话。默认阈值 62 fps——90/120 等高刷内容会被直接拦截，30/60 不受影响。仅 Shizuku/Root 模式生效（UID 过滤捕获，只测应用本身）；MediaProjection 模式会把悬浮层一起测进去，不启用此检查。</string>
    <string name="hdr_guard_toast">检测到 HDR 内容，已自动结束帧生成</string>
    <string name="output_stalled_toast">画面输出停滞（HDR 切换），已自动结束帧生成</string>
    <string name="fps_guard_toast">检测到原始帧率约 %1$d fps，超过阈值，已自动关闭帧生成</string>
    <string name="fps_guard_threshold_label">阈值（fps，原始帧率高于此值自动关闭）</string>
    <string name="fps_guard_threshold_invalid">请输入 30–240 之间的数字</string>
    <string name="pause_on_touch_desc">手指按在屏幕上时自动隐藏插帧层，触摸零延迟，松开约 0.25 秒后恢复。适合刷网页、看视频等场景；玩游戏必须关闭。Shizuku/Root 模式可长按或点按屏幕暂停插帧，MediaProjection 模式只能点按屏幕暂停插帧。</string>
    <string name="param_frame_graph">帧节奏曲线图</string>
    <string name="param_frame_graph_desc">在悬浮层中实时显示生成帧的间隔曲线。用于诊断卡顿。</string>

    <string name="dll_status_none">尚未选择 Lossless.dll。</string>
    <string name="dll_pick_button">选择 Lossless.dll</string>
    <string name="dll_reextract_button">重新提取着色器</string>

    <string name="param_multiplier">帧倍率</string>
    <string name="param_multiplier_desc">每个真实帧生成的帧数。2 = 每两帧之间插一帧。手机上建议 3–4。</string>
    <string name="param_flow_scale">光流缩放</string>
    <string name="param_flow_scale_desc">内部运动估计的分辨率。越低越快但越不精确。</string>
    <string name="param_performance_mode">性能模式（LSFG 3.1P）</string>
    <string name="param_performance_mode_desc">使用更快但画质较低的着色器变体。中端 GPU 推荐。</string>
    <string name="param_anti_artifacts">抗伪影模式</string>
    <string name="param_anti_artifacts_desc">在镜头快速移动时抑制生成帧，减少角色残缺和扭曲。默认关闭。</string>
    <string name="param_framegen_fp16">FP16 帧生成着色器</string>
    <string name="param_framegen_fp16_desc">使用 Lossless.dll 内预编译的半精度着色器变体代替全精度 DXBC 版本。降低 GPU 负载和显存带宽。画质几乎相同；出现异常时自动回退 FP32。</string>
    <string name="param_npu_post">NPU 图像增强</string>
    <string name="param_npu_post_desc_available">在专用加速器上运行手工设计的 NNAPI 计算图（锐化、细节增强、色度清理、游戏清晰）。设备：%1$s</string>
    <string name="param_npu_post_desc_unavailable">已停用：Android 未报告专用 NNAPI 加速器。设备：%1$s</string>
    <string name="param_npu_preset">NPU 预设</string>
    <string name="npu_preset_off">关闭</string>
    <string name="npu_preset_sharpen">锐化</string>
    <string name="npu_preset_detail_boost">细节</string>
    <string name="npu_preset_chroma_clean">纯净</string>
    <string name="npu_preset_game_crisp">游戏</string>
    <string name="param_npu_amount">NPU 强度</string>
    <string name="param_npu_amount_desc">增强内核的强度。数值越高画面越锐利，但可能放大压缩伪影。</string>
    <string name="param_npu_radius">NPU 半径</string>
    <string name="param_npu_radius_desc">锐化遮罩路径使用的模糊半径。半径越大突出整体轮廓；越小聚焦细节。</string>
    <string name="param_npu_upscale">NPU 放大倍数</string>
    <string name="param_npu_upscale_desc">1x 保持输出尺寸；2x 在增强前请求 NPU 双线性放大。</string>

    <string name="param_cpu_post">CPU 后处理</string>
    <string name="param_cpu_post_desc">在 NPU 阶段之后应用的纯 CPU 像素处理。开销低、随时可用，可在预设之上调节饱和度、自然度和暗角。</string>
